# Copy this file to .env and fill in your values
# Get your free Gemini API key at: https://aistudio.google.com/

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: CORS origins for production (comma-separated)
# ALLOWED_ORIGINS=https://your-github-pages-url.github.io
